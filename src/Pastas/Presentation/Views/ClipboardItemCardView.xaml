<UserControl x:Class="Pastas.Presentation.Views.ClipboardItemCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="78"
             d:DesignWidth="640">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF2A241F" />
        <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#FF342D26" />
        <SolidColorBrush x:Key="CardSelectedBackgroundBrush" Color="#FF392F26" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF4A4036" />
        <SolidColorBrush x:Key="HoverBorderBrush" Color="#FF6A5A4C" />
        <SolidColorBrush x:Key="SelectedBorderBrush" Color="#FFEFE3D0" />
        <SolidColorBrush x:Key="CreamTextBrush" Color="#FFF4EBDD" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFC6B9A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD1A764" />
        <SolidColorBrush x:Key="PinnedBorderBrush" Color="#FFE1BC7A" />

        <Style x:Key="CardSelectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionIconButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="#FF2F2822" />
            <Setter Property="BorderBrush" Value="#FF55493E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#FF3A3129" />
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="#FF6A5A4B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#FF251F1A" />
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#FF352D25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="ItemCard" Margin="0,0,0,8" Padding="12,10" CornerRadius="14" MinHeight="78" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource CardHoverBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PinnedBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource CardSelectedBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SelectedBorderBrush}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsPinned}" Value="True" />
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FF3E3429" />
                        <Setter Property="BorderBrush" Value="#FFE5C689" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsPinned}" Value="True" />
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FF372F27" />
                        <Setter Property="BorderBrush" Value="#FFE7CA91" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FF3D332A" />
                        <Setter Property="BorderBrush" Value="#FFF4E8D8" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                <Border Width="30"
                        Height="30"
                        CornerRadius="9"
                        Background="#FF221D18"
                        BorderBrush="#FF4E4339"
                        BorderThickness="1">
                    <TextBlock Text="I"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </Border>
                <Border Width="12"
                        Height="12"
                        CornerRadius="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-2,-2,0"
                        Background="#FF1F1A15"
                        BorderBrush="#FF5E513F"
                        BorderThickness="1"
                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="P"
                               FontSize="8"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" />
                </Border>
            </Grid>

            <Button x:Name="CardSelectButton"
                    Grid.Column="1"
                    Style="{StaticResource CardSelectButtonStyle}"
                    HorizontalContentAlignment="Left"
                    Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.InputBindings>
                    <MouseBinding Gesture="RightClick" Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </Button.InputBindings>
                <StackPanel Margin="2,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PreviewText}" Foreground="{StaticResource CreamTextBrush}" FontSize="13" Margin="0,0,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="20" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <StackPanel x:Name="Actions"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Visibility="{Binding ElementName=ItemCard, Path=IsMouseOver, Converter={StaticResource BoolToVisibility}}">
                <Button Content="View" ToolTip="Preview" Style="{StaticResource CardActionIconButtonStyle}" Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                <Button ToolTip="Pin or unpin" MinWidth="60" Style="{StaticResource CardActionIconButtonStyle}" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CardActionIconButtonStyle}">
                            <Setter Property="Content" Value="Pin" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Content" Value="Unpin" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Del" ToolTip="Delete" Style="{StaticResource CardActionIconButtonStyle}" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
