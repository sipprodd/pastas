<Window x:Class="Pastas.Presentation.Notifications.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300"
        Height="82"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">
    <Border CornerRadius="14" Background="#FF1F1F1F" BorderBrush="#FF2F2F2F" BorderThickness="1" Padding="12">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="#FFF1F1F1" FontSize="14"/>
            <TextBlock x:Name="SubtitleText" Margin="0,3,0,0" Foreground="#FFB9B9B9" FontSize="12"/>
        </StackPanel>
    </Border>
</Window>
