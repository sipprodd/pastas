<Window x:Class="Pastas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:Pastas.Domain.Enums"
        mc:Ignorable="d"
        Title="Pastas"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterScreen"
        Background="#FF171613">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF171613" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF23201C" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FF2A2622" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF3F3932" />
        <SolidColorBrush x:Key="CreamTextBrush" Color="#FFF4EBDD" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFC6B9A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD1A764" />
        <Style x:Key="ChipButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource CreamTextBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Border Background="{StaticResource AppBackgroundBrush}" Padding="18">
        <Grid MaxWidth="760" HorizontalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><TextBlock Text="pastas" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource CreamTextBrush}"/><TextBlock Text="  clipboard" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Bottom"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Settings" Style="{StaticResource ChipButtonStyle}" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="Close" Style="{StaticResource ChipButtonStyle}" Click="CloseButton_OnClick"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=False}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Height="36" Width="420" VerticalContentAlignment="Center" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource CreamTextBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" Padding="12,4" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Grid.Column="1" Width="140" Margin="10,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding SelectedSortMode}" Background="{StaticResource SurfaceElevatedBrush}" Foreground="{StaticResource CreamTextBrush}" BorderBrush="{StaticResource SubtleBorderBrush}">
                    <ComboBoxItem Content="Recent" Tag="{x:Static domain:SortMode.Recent}"/><ComboBoxItem Content="Oldest" Tag="{x:Static domain:SortMode.Oldest}"/><ComboBoxItem Content="Most copied" Tag="{x:Static domain:SortMode.MostCopied}"/>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="2">
                <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=False}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="All" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.All}"/>
                        <Button Content="Text" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Text}"/>
                        <Button Content="Images" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Images}"/>
                        <Button Content="Pinned" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Pinned}"/>
                        <Button Content="Protected" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Protected}"/>
                    </WrapPanel>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate><DataTemplate><Border x:Name="ItemCard" Margin="0,0,0,8" Padding="12" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="8" Background="#FF1E1B17" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"><TextBlock Text="{Binding ItemGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding PreviewText}" Foreground="{StaticResource CreamTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/><TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/></StackPanel><StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed"><Button Content="Preview" Style="{StaticResource ChipButtonStyle}" Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Pin" Style="{StaticResource ChipButtonStyle}" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="Delete" Style="{StaticResource ChipButtonStyle}" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel><Button Grid.ColumnSpan="3" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Grid></Border><DataTemplate.Triggers><Trigger SourceName="ItemCard" Property="IsMouseOver" Value="True"><Setter TargetName="Actions" Property="Visibility" Value="Visible"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Border Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibility}}" Background="#C0151412" CornerRadius="14" Padding="12">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Back" Style="{StaticResource ChipButtonStyle}" Command="{Binding ClosePreviewCommand}"/><TextBlock Grid.Column="1" Text="Item Preview" Foreground="{StaticResource CreamTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Close" Style="{StaticResource ChipButtonStyle}" Command="{Binding ClosePreviewCommand}"/></Grid>
                        <Border Grid.Row="1" Margin="0,12" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12"><ScrollViewer><StackPanel><TextBlock Text="Protected item" Foreground="{StaticResource CreamTextBrush}" Visibility="{Binding SelectedItem.IsProtected, Converter={StaticResource BoolToVisibility}}"/><Image Source="{Binding SelectedItem.ImagePath}" MaxHeight="320" Stretch="Uniform"/><TextBlock Text="{Binding SelectedItem.FullText}" Foreground="{StaticResource CreamTextBrush}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Copy" Style="{StaticResource ChipButtonStyle}" Command="{Binding CopyItemCommand}" CommandParameter="{Binding SelectedItem}"/><Button Content="Pin/Unpin" Style="{StaticResource ChipButtonStyle}" Command="{Binding TogglePinCommand}" CommandParameter="{Binding SelectedItem}"/><Button Content="Delete" Style="{StaticResource ChipButtonStyle}" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding SelectedItem}"/><Button Content="Close" Style="{StaticResource ChipButtonStyle}" Command="{Binding ClosePreviewCommand}"/></StackPanel>
                    </Grid>
                </Border>

                <Border Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                    <StackPanel><TextBlock Text="Settings" FontSize="22" Foreground="{StaticResource CreamTextBrush}"/><WrapPanel Margin="0,10,0,14"><TextBlock Text="General" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0"/><TextBlock Text="Storage" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,0"/><TextBlock Text="Security" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,14,0"/><TextBlock Text="Notifications" Foreground="{StaticResource MutedTextBrush}"/></WrapPanel><TextBlock Text="Hotkey: Alt+V" Foreground="{StaticResource CreamTextBrush}" Margin="0,0,0,6"/><TextBlock Text="Max items: 500" Foreground="{StaticResource CreamTextBrush}" Margin="0,0,0,6"/><TextBlock Text="Notifications: enabled" Foreground="{StaticResource CreamTextBrush}" Margin="0,0,0,6"/><TextBlock Text="Protected items: masked" Foreground="{StaticResource CreamTextBrush}" Margin="0,0,0,12"/><Button Content="Close" Width="90" Style="{StaticResource ChipButtonStyle}" Command="{Binding CloseSettingsCommand}"/></StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Enter — copy    Space — preview    Esc — close"/>
            </Border>
        </Grid>
    </Border>
</Window>
