<Window x:Class="Pastas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:Pastas.Domain.Enums"
        mc:Ignorable="d"
        Title="Pastas"
        Width="940"
        Height="680"
        Background="#FF171613">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF171613" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF23201C" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FF2A2622" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF3F3932" />
        <SolidColorBrush x:Key="CreamTextBrush" Color="#FFF4EBDD" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFC6B9A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD1A764" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF34302A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="pastas"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource CreamTextBrush}" />
            <TextBlock Text="Clipboard history"
                       Margin="0,2,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}" />
            <TextBox Margin="0,14,0,0"
                     Style="{StaticResource SearchTextBoxStyle}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="0,10,0,0"
                    Padding="14,7"
                    HorizontalAlignment="Left"
                    Content="Search"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SearchCommand}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,14" ItemHeight="32">
            <Button Content="All" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.All}" />
            <Button Content="Text" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Text}" />
            <Button Content="Images" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Images}" />
            <Button Content="Pinned" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Pinned}" />
            <Button Margin="0,0,16,0" Content="Protected" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Protected}" />

            <ComboBox Width="170"
                      Height="32"
                      Margin="0,0,8,0"
                      Padding="8,2"
                      Background="{StaticResource SurfaceElevatedBrush}"
                      Foreground="{StaticResource CreamTextBrush}"
                      BorderBrush="{StaticResource SubtleBorderBrush}"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedSortMode}">
                <ComboBoxItem Content="Recent" Tag="{x:Static domain:SortMode.Recent}" />
                <ComboBoxItem Content="Oldest" Tag="{x:Static domain:SortMode.Oldest}" />
                <ComboBoxItem Content="Most copied" Tag="{x:Static domain:SortMode.MostCopied}" />
            </ComboBox>
            <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SetSortModeCommand}" CommandParameter="{Binding SelectedSortMode}" />
            <Button Content="Refresh" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="14" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="88"
                                            Height="88"
                                            Margin="0,0,14,0"
                                            CornerRadius="10"
                                            Background="#FF1C1916"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding ThumbnailPath}"
                                               Stretch="UniformToFill"
                                               Margin="4"
                                               ClipToBounds="True" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding PreviewText}"
                                                   Foreground="{StaticResource CreamTextBrush}"
                                                   Margin="0,6,0,6"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="62" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceLabel}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" />
                                            <TextBlock Text="  •  "
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding TimeLabel}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Copy" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Content="Pin" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Margin="0" Content="Delete" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="15"
                       FontStyle="Italic"
                       Text="{Binding EmptyStateText}" />
        </Grid>

        <Border Grid.Row="3"
                HorizontalAlignment="Right"
                Padding="14,9"
                Style="{StaticResource CardBorderStyle}"
                Background="#FF332D25"
                MaxWidth="320"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Foreground="{StaticResource CreamTextBrush}"
                       FontSize="12"
                       Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
