<Window x:Class="Pastas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:Pastas.Domain.Enums"
        xmlns:views="clr-namespace:Pastas.Presentation.Views"
        mc:Ignorable="d"
        Title="Pastas"
        Width="740"
        Height="590"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="ShellBrush" Color="#FF171613" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF23201C" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FF2A2622" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#FF2F2A25" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF3F3932" />
        <SolidColorBrush x:Key="CreamTextBrush" Color="#FFF4EBDD" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFC6B9A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD1A764" />
        <SolidColorBrush x:Key="PinnedBorderBrush" Color="#FFE1BC7A" />

        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="#FF2D2823" />
            <Setter Property="BorderBrush" Value="#FF4B433A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#FF373029" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#FF63584A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#FF221E1A" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#FF746655" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#FF746655" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardSelectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="#FF2C2823" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#FF38322C" />
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="#FF5A5147" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#FF231F1B" />
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortMenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="170" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="#FF302A24" />
            <Setter Property="BorderBrush" Value="#FF665A4D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0,14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SortBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <Path Grid.Column="1" Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFE4D8C6" Opacity="0.85" Data="M 0 0 L 5 5 L 10 0 Z" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SortBorder" Property="Background" Value="#FF38312A" />
                                <Setter TargetName="SortBorder" Property="BorderBrush" Value="#FF766857" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SortBorder" Property="Background" Value="#FF231F1B" />
                                <Setter TargetName="SortBorder" Property="BorderBrush" Value="#FF8A7A67" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SortBorder" Property="BorderBrush" Value="#FF8A7A67" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Open">
                                <Setter TargetName="SortBorder" Property="Background" Value="#FF3A332C" />
                                <Setter TargetName="SortBorder" Property="BorderBrush" Value="#FF8A7A67" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortMenuItemButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="#FF2C2722" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SortItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SortItemBorder" Property="Background" Value="#FF3A332C" />
                                <Setter TargetName="SortItemBorder" Property="BorderBrush" Value="#FF665A4C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SortItemBorder" Property="Background" Value="#FF221E1A" />
                                <Setter TargetName="SortItemBorder" Property="BorderBrush" Value="#FF7A6C5B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SortItemBorder" Property="BorderBrush" Value="#FF7A6C5B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22" Background="{StaticResource ShellBrush}" BorderBrush="#FF3A342D" BorderThickness="1" Padding="16">
        <Grid Width="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="pastas" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource CreamTextBrush}" />
                    <TextBlock Text="clipboard" Margin="8,0,0,0" VerticalAlignment="Bottom" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Settings" MinWidth="96" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ChipButtonStyle}" />
                    <Button Content="Close" MinWidth="82" Style="{StaticResource ChipButtonStyle}" Margin="0" Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <Grid>
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource RoundedTextBoxStyle}" Padding="14,6,12,6" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Search" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8" MinHeight="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Content="All" MinWidth="62" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.All}" />
                    <Button Content="Text" MinWidth="66" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Text}" />
                    <Button Content="Images" MinWidth="78" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Images}" />
                    <Button Content="Pinned" MinWidth="78" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Pinned}" />
                </WrapPanel>
                <Button x:Name="SortMenuButton"
                        Grid.Column="1"
                        Style="{StaticResource SortMenuButtonStyle}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Content="Recent"
                        Click="SortMenuButton_OnClick" />
                <Popup x:Name="SortMenuPopup"
                       Grid.Column="1"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=SortMenuButton}"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       HorizontalOffset="0"
                       VerticalOffset="2"
                       Opened="SortMenuPopup_OnOpened"
                       Closed="SortMenuPopup_OnClosed"
                       PopupAnimation="Fade">
                    <Border Width="{Binding ActualWidth, ElementName=SortMenuButton}"
                            Padding="6,6,6,5"
                            Background="#FF2E2924"
                            BorderBrush="#FF665A4D"
                            BorderThickness="1"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <Button Content="Recent" Style="{StaticResource SortMenuItemButtonStyle}" Click="SortRecent_OnClick" />
                            <Button Content="Oldest" Style="{StaticResource SortMenuItemButtonStyle}" Click="SortOldest_OnClick" />
                            <Button Content="Most copied" Margin="0" Style="{StaticResource SortMenuItemButtonStyle}" Click="SortMostCopied_OnClick" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Grid Grid.Row="3">
                <Grid Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:ClipboardItemCardView />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding EmptyStateText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                    </Grid>
                </Grid>

                <views:PreviewPanelView />

                <Border Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="22" Foreground="{StaticResource CreamTextBrush}" />
                        <TextBlock Text="Settings panel placeholder for MVP shell." Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,14" />
                        <Button Content="Clear data" Width="140" Style="{StaticResource ChipButtonStyle}" Command="{Binding OpenClearDataCommand}" Margin="0,0,0,10" />
                        <Button Content="Close" Width="90" Style="{StaticResource ChipButtonStyle}" Command="{Binding CloseSettingsCommand}" Margin="0" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsClearDataOpen, Converter={StaticResource BoolToVisibility}}" Background="#AA151310">
                    <Grid>
                        <Border Width="410" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Clear data" FontSize="22" Foreground="{StaticResource CreamTextBrush}" />
                                <TextBlock Text="Choose what to delete from Pastas history. This cannot be undone." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,16" />
                                <CheckBox Content="Text" Foreground="{StaticResource CreamTextBrush}" IsChecked="{Binding ClearTextSelected}" Margin="0,0,0,8"/>
                                <CheckBox Content="Images" Foreground="{StaticResource CreamTextBrush}" IsChecked="{Binding ClearImagesSelected}" Margin="0,0,0,8"/>
                                <CheckBox Content="Pinned objects" Foreground="{StaticResource CreamTextBrush}" IsChecked="{Binding ClearPinnedSelected}" Margin="0,0,0,18"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Width="90" Style="{StaticResource ChipButtonStyle}" Command="{Binding CloseClearDataCommand}" />
                                    <Button Content="Delete selected" Width="130" Margin="0" Style="{StaticResource ChipButtonStyle}" Command="{Binding ConfirmClearDataCommand}" IsEnabled="{Binding CanConfirmClearData}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" Margin="0,10,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center">
                        <Run Text="Enter - copy" />
                        <Run Text="    " />
                        <Run Text="Space - preview" />
                        <Run Text="    " />
                        <Run Text="Esc - close" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" Text="ИСИП-24-3 · Гоголев Айхал · Якутск · 2026" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
