<Window x:Class="Pastas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:Pastas.Domain.Enums"
        mc:Ignorable="d"
        Title="Pastas"
        Width="740"
        Height="590"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="ShellBrush" Color="#FF171613" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF23201C" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FF2A2622" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#FF2F2A25" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF3F3932" />
        <SolidColorBrush x:Key="CreamTextBrush" Color="#FFF4EBDD" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFC6B9A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD1A764" />
        <SolidColorBrush x:Key="PinnedBorderBrush" Color="#FFE1BC7A" />

        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardSelectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardActionIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="#FF2C2823" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#FF38322C" />
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="#FF5A5147" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#FF231F1B" />
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="154" />
            <Setter Property="MinWidth" Value="154" />
            <Setter Property="MaxWidth" Value="154" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="PopupAnimation" Value="Fade" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="22" Background="{StaticResource ShellBrush}" BorderBrush="#FF3A342D" BorderThickness="1" Padding="16">
        <Grid Width="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="pastas" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource CreamTextBrush}" />
                    <TextBlock Text="clipboard" Margin="8,0,0,0" VerticalAlignment="Bottom" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ChipButtonStyle}" />
                    <Button Content="Close" Style="{StaticResource ChipButtonStyle}" Margin="0" Click="CloseButton_OnClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <Grid>
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource RoundedTextBoxStyle}" Padding="14,6,12,6" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Search" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8" MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Content="All" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.All}" />
                    <Button Content="Text" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Text}" />
                    <Button Content="Images" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Images}" />
                    <Button Content="Pinned" Style="{StaticResource ChipButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="{x:Static domain:ClipboardFilter.Pinned}" />
                </WrapPanel>
                <ToggleButton Grid.Column="1" Style="{StaticResource SortButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Content="Sort">
                    <ToggleButton.ContextMenu>
                        <ContextMenu Background="{StaticResource SurfaceElevatedBrush}"
                                     BorderBrush="{StaticResource SubtleBorderBrush}"
                                     BorderThickness="1"
                                     IsOpen="{Binding PlacementTarget.IsChecked, RelativeSource={RelativeSource Self}, Mode=TwoWay}">
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
                                    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                    <Setter Property="Padding" Value="10,6" />
                                </Style>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFD1A764" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF1A1612" />
                            </ContextMenu.Resources>
                            <MenuItem Header="Recent" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static domain:SortMode.Recent}" />
                            <MenuItem Header="Oldest" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static domain:SortMode.Oldest}" />
                            <MenuItem Header="Most copied" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static domain:SortMode.MostCopied}" />
                        </ContextMenu>
                    </ToggleButton.ContextMenu>
                </ToggleButton>
            </Grid>

            <Grid Grid.Row="3">
                <Grid Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ItemCard" Margin="0,0,0,8" Padding="10" CornerRadius="12" MinHeight="74" Background="#FF26221E" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="#FF1E1B17" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="I" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="13" />
                                                    </Border>
                                                    <TextBlock Text="P" FontSize="10" Margin="18,-2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <Button x:Name="CardSelectButton" Grid.Column="1" Style="{StaticResource CardSelectButtonStyle}" HorizontalContentAlignment="Left" Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Button.InputBindings>
                                                        <MouseBinding Gesture="RightClick" Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </Button.InputBindings>
                                                    <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PreviewText}" Foreground="{StaticResource CreamTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="18" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                                            <TextBlock Text=" | " Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                                            <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <Button Content="View" ToolTip="Preview" Style="{StaticResource CardActionIconButtonStyle}" Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <Button Content="Pin" ToolTip="Pin or unpin" Style="{StaticResource CardActionIconButtonStyle}" Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <Button Content="Del" ToolTip="Delete" Style="{StaticResource CardActionIconButtonStyle}" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="ItemCard" Property="IsMouseOver" Value="True"><Setter TargetName="Actions" Property="Visibility" Value="Visible" /></Trigger>
                                            <Trigger SourceName="CardSelectButton" Property="IsKeyboardFocused" Value="True"><Setter TargetName="Actions" Property="Visibility" Value="Visible" /></Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="ItemCard" Property="Background" Value="#FF2D2823" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource PinnedBorderBrush}" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding EmptyStateText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False" />
                    </Grid>
                </Grid>

                <Border Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibility}}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Preview" Foreground="{StaticResource CreamTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,10" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="10" Padding="12">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.IsProtected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Protected item" Foreground="{StaticResource CreamTextBrush}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Content is hidden" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedItem.IsText}" Value="True" /><Condition Binding="{Binding SelectedItem.IsProtected}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding SelectedItem.PreviewBodyText}" Foreground="{StaticResource CreamTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedItem.IsImage}" Value="True" /><Condition Binding="{Binding SelectedItem.IsProtected}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style>
                                        </StackPanel.Style>
                                        <Image MaxHeight="340" Stretch="Uniform" Source="{Binding SelectedItem.ImagePath}">
                                            <Image.Style>
                                                <Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.HasImagePath}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                            </Image.Style>
                                        </Image>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.HasImagePath}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Image item" Foreground="{StaticResource CreamTextBrush}" FontSize="16" />
                                            <TextBlock Text="Image unavailable" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                <Button Content="Copy" Style="{StaticResource ChipButtonStyle}" Command="{Binding CopyItemCommand}" CommandParameter="{Binding SelectedItem}" />
                                <Button Content="Pin" Style="{StaticResource ChipButtonStyle}" Command="{Binding TogglePinCommand}" CommandParameter="{Binding SelectedItem}" />
                                <Button Content="Del" Style="{StaticResource ChipButtonStyle}" Command="{Binding DeleteItemCommand}" CommandParameter="{Binding SelectedItem}" Margin="0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Back" Style="{StaticResource ChipButtonStyle}" Command="{Binding ClosePreviewCommand}" Margin="0,2,0,0" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="22" Foreground="{StaticResource CreamTextBrush}" />
                        <TextBlock Text="Settings panel placeholder for MVP shell." Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,14" />
                        <Button Content="Close" Width="90" Style="{StaticResource ChipButtonStyle}" Command="{Binding CloseSettingsCommand}" Margin="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Margin="0,10,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center">
                        <Run Text="Enter - copy" />
                        <Run Text="    " />
                        <Run Text="Space - preview" />
                        <Run Text="    " />
                        <Run Text="Esc - close" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" Text="ИСИП-24-3 · Гоголев Айхал · Якутск · 2026" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>


