<Window x:Class="Pastas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="clr-namespace:Pastas.Domain.Enums"
        mc:Ignorable="d"
        Title="Pastas"
        Width="940"
        Height="680"
        Background="#FF171613">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF171613" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF23201C" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FF2A2622" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF3F3932" />
        <SolidColorBrush x:Key="CreamTextBrush" Color="#FFF4EBDD" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFC6B9A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD1A764" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF34302A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
                        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemRoot"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#FF35312C" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#FF3C352D" />
                                            <Setter Property="Foreground" Value="{StaticResource CreamTextBrush}" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True" />
                                                <Condition Property="IsHighlighted" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#FF474036" />
                                        </MultiTrigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#FF35312C" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                            <Setter TargetName="ItemRoot" Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF2A2622" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3C352D" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2A2622" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF4EBDD" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF4EBDD" />
            </Style.Resources>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="pastas"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource CreamTextBrush}" />
            <TextBlock Text="Clipboard history"
                       Margin="0,2,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}" />

            <Grid Margin="0,12,0,0"
                  HorizontalAlignment="Left"
                  Width="430">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Margin="0,0,8,0"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="1"
                        Margin="0"
                        Padding="12,6"
                        MinWidth="86"
                        Height="36"
                        Content="Search"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SearchCommand}" />
            </Grid>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,14" ItemHeight="32">
            <Button Content="All"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static domain:ClipboardFilter.All}" />

            <Button Content="Text"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static domain:ClipboardFilter.Text}" />

            <Button Content="Images"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static domain:ClipboardFilter.Images}" />

            <Button Content="Pinned"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static domain:ClipboardFilter.Pinned}" />

            <Button Margin="0,0,16,0"
                    Content="Protected"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SetFilterCommand}"
                    CommandParameter="{x:Static domain:ClipboardFilter.Protected}" />

            <ComboBox Width="170"
                      Height="32"
                      Margin="0,0,8,0"
                      Style="{StaticResource SortComboBoxStyle}"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedSortMode}">
                <ComboBoxItem Content="Recent" Tag="{x:Static domain:SortMode.Recent}" />
                <ComboBoxItem Content="Oldest" Tag="{x:Static domain:SortMode.Oldest}" />
                <ComboBoxItem Content="Most copied" Tag="{x:Static domain:SortMode.MostCopied}" />
            </ComboBox>

            <Button Content="Refresh"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RefreshCommand}" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemCard"
                                    Margin="0,0,0,12"
                                    Padding="14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="88"
                                            Height="88"
                                            Margin="0,0,14,0"
                                            CornerRadius="10"
                                            Background="#FF1C1916"
                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Image Source="{Binding ThumbnailPath}"
                                               Stretch="UniformToFill"
                                               Margin="4"
                                               ClipToBounds="True" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />

                                        <TextBlock Text="{Binding PreviewText}"
                                                   Foreground="{StaticResource CreamTextBrush}"
                                                   Margin="0,6,0,6"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="62" />

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceLabel}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" />
                                            <TextBlock Text="  •  "
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding TimeLabel}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.ColumnSpan="3"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Focusable="False">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <StackPanel x:Name="ActionButtons"
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                Visibility="Collapsed"
                                                Panel.ZIndex="2">
                                        <Button Content="Copy"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <Button Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Setter Property="Content" Value="Pin" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Content" Value="Unpin" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Margin="0"
                                                Content="Delete"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>

                                <Trigger SourceName="ItemCard" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ActionButtons" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ItemCard" Property="Background" Value="#FF2A2622" />
                                </Trigger>

                                <Trigger SourceName="ItemCard" Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="ActionButtons" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ItemCard" Property="Background" Value="#FF2A2622" />
                                </Trigger>

                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="ItemCard" Property="Background" Value="#FF2A2622" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="15"
                       FontStyle="Italic"
                       Text="{Binding EmptyStateText}" />

            <Border Background="#B2161512"
                    Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Panel.ZIndex="15">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="700"
                      MaxWidth="700"
                      Margin="20">
                    <Border Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedItem.TypeLabel}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding SelectedItem.SourceLabel}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,2,0,10"
                                               FontSize="12" />

                                    <TextBlock Text="Protected item"
                                               Foreground="{StaticResource CreamTextBrush}"
                                               FontSize="15">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem.IsProtected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Image MaxHeight="420"
                                           Stretch="Uniform"
                                           Source="{Binding SelectedItem.ImagePath}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem.IsImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <TextBlock Foreground="{StaticResource CreamTextBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Text" Value="{Binding SelectedItem.PreviewText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem.IsText}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Text" Value="{Binding SelectedItem.FullText}" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SelectedItem.IsText}" Value="True" />
                                                            <Condition Binding="{Binding SelectedItem.FullText}" Value="" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="{Binding SelectedItem.PreviewText}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,14,0,0">
                                <Button Content="Copy"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding CopyItemCommand}"
                                        CommandParameter="{Binding SelectedItem}" />
                                <Button Command="{Binding TogglePinCommand}"
                                        CommandParameter="{Binding SelectedItem}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Content" Value="Pin" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.IsPinned}" Value="True">
                                                    <Setter Property="Content" Value="Unpin" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Delete"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding DeleteItemCommand}"
                                        CommandParameter="{Binding SelectedItem}" />
                                <Button Margin="0"
                                        Content="Close"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ClosePreviewCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                HorizontalAlignment="Right"
                Padding="14,9"
                Style="{StaticResource CardBorderStyle}"
                Background="#FF332D25"
                MaxWidth="320"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <TextBlock Foreground="{StaticResource CreamTextBrush}"
                       FontSize="12"
                       Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</Window>
